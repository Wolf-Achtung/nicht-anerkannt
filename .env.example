# Copy to .env for local development. Not read directly by server.js -- use
# your shell/process manager (e.g. `export $(cat .env | xargs)`, dotenv, or
# your deploy platform's env var UI) to load these.

# One of these three is required for the AI endpoints (/api/chat, /api/daily, ...);
# checked in this order. Without any of them, AI endpoints return an error and
# /api/daily falls back to the local data/daily-questions.json pool.
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
AI_API_KEY=

# Anthropic model ID used for all AI endpoints. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# Thinking. Current models reason before answering by default, and those
# thinking tokens count against the same max_tokens budget as the answer --
# which silently truncated half the workshop tools until August 2026. Every
# endpoint here asks for a short, fully specified JSON object, so thinking is
# switched off. Set to "adaptive" to turn it back on; then raise the per-
# endpoint max_tokens values in server.js, because thinking will claim part
# of them, and consider AI_EFFORT=low to keep that share small.
# AI_THINKING=disabled
# AI_EFFORT=low          # only used when AI_THINKING=adaptive

# Waiting behaviour when the AI provider rate-limits us. The provider's
# Retry-After header wins; these are the fallbacks (milliseconds).
# AI_RATE_LIMIT_WAIT_MS=12000
# AI_RATE_LIMIT_WAIT_MAX_MS=30000
# AI_RETRY_BASE_MS=700

# Base URL of the AI API. Only for testing against a local stub.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Comma-separated list of origins allowed to call /api/* with CORS.
# Defaults to the primary domain plus the legacy domain (still redirecting).
# ALLOWED_ORIGINS=https://nichts-geschenkt.de,https://www.nichts-geschenkt.de,https://nicht-anerkannt.info,https://www.nicht-anerkannt.info

# Number of trusted reverse-proxy hops in front of the server, for correct
# per-IP rate limiting (see express-rate-limit's trust proxy docs).
# Use "false" to disable trust proxy entirely. Defaults to 1.
# TRUST_PROXY=1

# Port the Express server listens on. Defaults to 3000.
# PORT=3000
